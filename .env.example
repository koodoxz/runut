# Runut (RUNUT) — example environment configuration
#
# Copy this file to .env (or export these variables in your shell/systemd
# unit) before running `runut`. Values below are placeholders only.

# API key for the optional threat-feed / WAF integration (configs/runut.yaml
# -> tameng.api_key, only read if tameng.enabled is true). Expanded at
# runtime via the ${TAMENG_API_KEY} syntax in Config::expand_env().
TAMENG_API_KEY=your-api-key-here
