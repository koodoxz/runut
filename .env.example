# Runut (MIMIR-RS) — example environment configuration
#
# Copy this file to .env (or export these variables in your shell/systemd
# unit) before running `mimir`. Values below are placeholders only.

# API key for the optional threat-feed / WAF integration (configs/mimir.yaml
# -> svalinn.api_key, only read if svalinn.enabled is true). Expanded at
# runtime via the ${SVALINN_API_KEY} syntax in Config::expand_env().
SVALINN_API_KEY=your-api-key-here
